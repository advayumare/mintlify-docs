{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Thread CRM Documentation",
  "theme": "almond",
  "fonts": {
    "family": "Google Sans"
  },
  "colors": {
    "primary": "#6729ff",
    "light": "#EFF6FF",
    "dark": "#6729ff"
  },
  "styling": {
